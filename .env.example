# PEOPLEPULSE AI — Environment Configuration

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Keys (Safe for Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API Key (Server-Side Only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# AI Provider ("gemini" or "mock")
AI_PROVIDER=gemini

# Secret for hashing and internal tokens
AUTH_SECRET=your-32-character-random-secret
